# Copy to env.sh and adjust for your machine:
#   cp env.sh.example env.sh
export OCR_DEVICE="${OCR_DEVICE:-gpu:0}"
export OCR_DPI="${OCR_DPI:-400}"
export OCR_WORKERS="${OCR_WORKERS:-8}"
export OCR_CPU_THREADS="${OCR_CPU_THREADS:-20}"
export OCR_DET_LIMIT_SIDE_LEN="${OCR_DET_LIMIT_SIDE_LEN:-2560}"
export OCR_DET_LIMIT_TYPE="${OCR_DET_LIMIT_TYPE:-max}"
export OCR_TEXT_DET_THRESH="${OCR_TEXT_DET_THRESH:-0.25}"
export OCR_TEXT_DET_BOX_THRESH="${OCR_TEXT_DET_BOX_THRESH:-0.5}"
export OCR_TEXT_DET_UNCLIP_RATIO="${OCR_TEXT_DET_UNCLIP_RATIO:-1.8}"
export OCR_REC_BATCH_SIZE="${OCR_REC_BATCH_SIZE:-16}"
export OCR_MAX_PAGE_PIXELS="${OCR_MAX_PAGE_PIXELS:-60000000}"
export OCR_MIN_SIDE_FOR_DET="${OCR_MIN_SIDE_FOR_DET:-2000}"
export OCR_PREPROCESS_MODE="${OCR_PREPROCESS_MODE:-enhance}"
# vllm_vl = PDF→이미지→Qwen2.5-VL (권장); paddle = PP-OCRv5 + optional refine
export OCR_BACKEND="${OCR_BACKEND:-vllm_vl}"
export OCR_REFINE_DEFAULT="${OCR_REFINE_DEFAULT:-none}"
# auto = vLLM 표 구조 보정(헤더 반복·줄바꿈 병합)은 문제 있을 때만; off/always
export VLLM_STRUCTURE_REFINE="${VLLM_STRUCTURE_REFINE:-auto}"
# server = PP-OCRv5_server_det + korean mobile rec; mobile = lighter det
export OCR_REC_MODEL="${OCR_REC_MODEL:-server}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}${LD_LIBRARY_PATH:+:}${HOME}/local/cudnn/usr/lib/aarch64-linux-gnu"

# DGX Spark 128GB profile (omit on non-DGX machines)
# source ./env.dgx-spark-128gb.sh

# --- DGX Spark 128GB defaults (env.dgx-spark-128gb.sh) ---
# REFINE_HF_MODEL=Qwen/Qwen2.5-14B-Instruct
# REFINE_MODEL_DIR=Qwen2.5-14B-Instruct
# VLLM_REFINE_BASE_URL=http://127.0.0.1:8002/v1
# VLLM_REFINE_MODEL=qwen-refine
# CHAT_GPU_MEMORY_UTIL=0.52  REFINE_GPU_MEMORY_UTIL=0.26
# VLLM_REFINE_FALLBACK_TO_CHAT=false

export VLLM_BASE_URL="${VLLM_BASE_URL:-http://127.0.0.1:8088/v1}"
export VLLM_MODEL="${VLLM_MODEL:-gemma-chat}"
export VLLM_VL_BASE_URL="${VLLM_VL_BASE_URL:-http://127.0.0.1:8003/v1}"
export VLLM_VL_MODEL="${VLLM_VL_MODEL:-qwen-vl-ocr}"
export VLLM_VL_MAX_TOKENS="${VLLM_VL_MAX_TOKENS:-8192}"
export VLLM_VL_TIMEOUT="${VLLM_VL_TIMEOUT:-180}"
export VLLM_VL_MAX_IMAGE_SIDE="${VLLM_VL_MAX_IMAGE_SIDE:-2048}"
export VLLM_REFINE_BASE_URL="${VLLM_REFINE_BASE_URL:-http://127.0.0.1:8002/v1}"
export VLLM_REFINE_MODEL="${VLLM_REFINE_MODEL:-qwen-refine}"
export VLLM_REFINE_FALLBACK_TO_CHAT="${VLLM_REFINE_FALLBACK_TO_CHAT:-false}"
export VLLM_API_KEY="${VLLM_API_KEY:-local}"
export VLLM_TIMEOUT="${VLLM_TIMEOUT:-60}"
export VLLM_ENABLED="${VLLM_ENABLED:-true}"
export VLLM_REFINE_THRESHOLD="${VLLM_REFINE_THRESHOLD:-0.85}"
export VLLM_AUTO_MODEL="${VLLM_AUTO_MODEL:-true}"
export VLLM_REFINE_BATCH="${VLLM_REFINE_BATCH:-true}"
export VLLM_MAX_TABLES_PER_BATCH="${VLLM_MAX_TABLES_PER_BATCH:-16}"
export VLLM_REFINE_MAX_TOKENS_MEDIUM="${VLLM_REFINE_MAX_TOKENS_MEDIUM:-1280}"
export VLLM_REFINE_MAX_TOKENS_SMALL="${VLLM_REFINE_MAX_TOKENS_SMALL:-1024}"
