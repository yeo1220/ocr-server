# Copy to env.sh and adjust for your machine:
#   cp env.sh.example env.sh
export OCR_DEVICE="${OCR_DEVICE:-gpu:0}"
export OCR_DPI="${OCR_DPI:-300}"
export OCR_WORKERS="${OCR_WORKERS:-8}"
export OCR_CPU_THREADS="${OCR_CPU_THREADS:-20}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}${LD_LIBRARY_PATH:+:}${HOME}/local/cudnn/usr/lib/aarch64-linux-gnu"
